
export component TitleBar inherits Rectangle {
    in property <string> username: "Username";
    in property <bool> connected: false;

    callback connection-toggle-requested();
    callback minimize-requested();
    callback close-window-requested();

    background: transparent;
    height: 32px;

    HorizontalLayout {
        spacing: 6px;
        alignment: center;

        // Left: status, vertically centered
        HorizontalLayout {
            width: 92px;
            spacing: 6px;
            alignment: center;

            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 4px;
                background: root.connected ? #0077C2 : #777A83;
            }

            Text {
                text: root.connected ? "Online" : "Offline";
                color: #92959C;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // Flexible spacer pushes greeting toward the center
        Rectangle {
            background: transparent;
            horizontal-stretch: 1;
        }

        // Center: greeting, vertically centered
        HorizontalLayout {
            spacing: 5px;
            alignment: center;

            Text {
                text: "Hi,";
                color: #F0F0F2;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                text: root.username;
                color: #0077C2;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        // Flexible spacer pushes controls to the right
        Rectangle {
            background: transparent;
            horizontal-stretch: 1;
        }

        // Right: controls, vertically centered
        HorizontalLayout {
            spacing: 5px;
            alignment: center;

            TouchArea {
                width: 94px;
                height: 27px;

                Rectangle {
                    background: root.connected ? #292B30 : #0077C2;
                    border-radius: 4px;

                    Text {
                        text: root.connected ? "Disconnect" : "Connect";
                        color: #FFFFFF;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                clicked => {
                    root.connection-toggle-requested();
                }
            }

            TouchArea {
                width: 29px;
                height: 27px;

                Rectangle {
                    background: #191B1E;
                    border-radius: 4px;

                    Text {
                        text: "−";
                        color: #92959C;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                clicked => {
                    root.minimize-requested();
                }
            }

            TouchArea {
                width: 29px;
                height: 27px;

                Rectangle {
                    background: #191B1E;
                    border-radius: 4px;

                    Text {
                        text: "×";
                        color: #92959C;
                        font-size: 17px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                clicked => {
                    root.close-window-requested();
                }
            }
        }
    }
}
