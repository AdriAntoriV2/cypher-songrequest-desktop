
export component TitleBar inherits Rectangle {
    in property <string> username: "Username";
    in property <bool> connected: false;

    callback connection-toggle-requested();
    callback minimize-requested();
    callback close-window-requested();

    background: transparent;
    height: 32px;

    // Drag the borderless window using otherwise empty title-bar space.
    WindowMoveArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
    }

    // LEFT: connection status.
    HorizontalLayout {
        spacing: 0px;
        alignment: start;

        Rectangle {
            width: 120px;
            background: transparent;

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: root.connected ? #0077C2 : #777A83;
                        }
                    }

                    Text {
                        text: root.connected ? "Online" : "Offline";
                        color: #92959C;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // CENTER: greeting.
    HorizontalLayout {
        alignment: center;
        spacing: 5px;

        Text {
            text: "Hi,";
            color: #F0F0F2;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            text: root.username;
            color: #0077C2;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    // RIGHT: interactive controls stay above the drag area.
    HorizontalLayout {
        alignment: end;
        spacing: 5px;

        TouchArea {
            width: 94px;
            height: 27px;

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 4px;
                background: root.connected ? #191B1E : #0077C2;
                border-width: 1px;
                border-color: root.connected ? #303238 : #0077C2;

                Text {
                    text: root.connected ? "Disconnect" : "Connect";
                    color: #F0F0F2;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            clicked => {
                root.connection-toggle-requested();
            }
        }

        TouchArea {
            width: 29px;
            height: 27px;

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 4px;
                background: #191B1E;
                border-width: 1px;
                border-color: #303238;

                Text {
                    text: "−";
                    color: #F0F0F2;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            clicked => {
                root.minimize-requested();
            }
        }

        TouchArea {
            width: 29px;
            height: 27px;

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 4px;
                background: #191B1E;
                border-width: 1px;
                border-color: #303238;

                Text {
                    text: "×";
                    color: #F0F0F2;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            clicked => {
                root.close-window-requested();
            }
        }
    }
}
