import { Button, Slider } from "std-widgets.slint";

export component PlayerControl inherits Rectangle {
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <float> volume: 0.5;
    in property <bool> paused: true;
    in property <bool> enabled: false;

    callback seek-requested(float);
    callback volume-requested(float);
    callback playback-toggle-requested();

    in property <string> track-key: "";

    private property <float> seek-position: root.position;
    private property <bool> seek-dragging: false;
    private property <bool> seek-pending: false;
    private property <float> pending-seek-position: 0;

    changed position => {
        if (root.seek-pending) {
            // Ignore stale playback positions until the seek takes effect.
            if (root.position >= root.pending-seek-position - 1.5
                && root.position <= root.pending-seek-position + 1.5) {
                root.seek-pending = false;
                root.seek-position = root.position;
            }
        } else if (!root.seek-dragging) {
            root.seek-position = root.position;
        }
    }

    changed track-key => {
        root.seek-dragging = false;
        root.seek-pending = false;
        root.seek-position = 0;
    }

    changed duration => {
        if (!root.seek-dragging && !root.seek-pending) {
            root.seek-position = root.position;
        }
    }

    width: 100%;
    height: 112px;

    background: #17191F;
    border-width: 1px;
    border-color: #30343E;
    border-radius: 8px;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 12px;
        spacing: 8px;

        // Row 1: Seek bar and timestamps
        HorizontalLayout {
            width: 100%;
            height: 32px;
            spacing: 12px;

            Rectangle {
                width: 56px;
                height: 32px;
                background: transparent;

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.format-time(root.position);
                    color: #E3E6ED;
                    font-size: 15px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }

            Slider {
                width: parent.width - 160px;
                height: 32px;

                enabled: root.enabled && root.duration > 0;
                minimum: 0;
                maximum: max(1, root.duration);

                value <=> root.seek-position;

                changed(value) => {
                    root.seek-dragging = true;
                }

                released(value) => {
                    root.seek-position = value;
                    root.pending-seek-position = value;
                    root.seek-pending = true;
                    root.seek-requested(value);
                    root.seek-dragging = false;
                }
            }

            Rectangle {
                width: 56px;
                height: 32px;
                background: transparent;

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.format-time(root.duration);
                    color: #E3E6ED;
                    font-size: 15px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }

        // Row 2: Play/pause and volume
        HorizontalLayout {
            width: 100%;
            height: 32px;
            spacing: 12px;

            Button {
                width: 40px;
                height: 32px;
                text: root.paused ? "▶" : "Ⅱ";
                enabled: root.enabled;

                clicked => {
                    root.playback-toggle-requested();
                }
            }

            Text {
                width: 48px;
                height: 32px;
                text: "Volume";
                color: #E3E6ED;
                font-size: 13px;
                vertical-alignment: center;
            }

            Slider {
                width: 180px;
                height: 32px;

                enabled: root.enabled;
                minimum: 0;
                maximum: 1;
                value: min(1, max(0, root.volume));

                changed => {
                    root.volume-requested(self.value);
                }
            }

            // Keeps the controls grouped on the left.
    Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }
        }
    }

    function format-time(seconds: float) -> string {
        let total = max(0, round(seconds));
        let minutes = floor(total / 60);
        let remaining = total - minutes * 60;

        return (minutes < 10 ? "0" : "") + minutes
            + ":"
            + (remaining < 10 ? "0" : "")
            + remaining;
    }
}
