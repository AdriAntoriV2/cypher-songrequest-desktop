import { Button, Slider } from "std-widgets.slint";

export component PlayerControl inherits Rectangle {
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <float> volume: 0.5;
    in property <bool> paused: true;
    in property <bool> enabled: false;

    callback seek-requested(float);
    callback volume-requested(float);
    callback playback-toggle-requested();

    width: 100%;
    height: 112px;

    background: #17191F;
    border-width: 1px;
    border-color: #30343E;
    border-radius: 8px;

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 12px;
        spacing: 8px;

        // Row 1: Seek bar and timestamps
        HorizontalLayout {
            width: 100%;
            height: 32px;
            spacing: 12px;

            Rectangle {
                width: 56px;
                height: 32px;
                background: transparent;

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.format-time(root.position);
                    color: #E3E6ED;
                    font-size: 15px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }

            Slider {
                width: parent.width - 160px;
                height: 32px;

                enabled: root.enabled && root.duration > 0;
                minimum: 0;
                maximum: max(1, root.duration);
                value: min(max(0, root.position), max(1, root.duration));

                changed value => {
                    root.seek-requested(self.value);
                }
            }

            Rectangle {
                width: 56px;
                height: 32px;
                background: transparent;

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.format-time(root.duration);
                    color: #E3E6ED;
                    font-size: 15px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }

        // Row 2: Play/pause and volume
        HorizontalLayout {
    width: 100%;
    height: 32px;
    spacing: 12px;

    Button {
        width: 40px;
        height: 32px;
        text: root.paused ? "▶" : "Ⅱ";
        enabled: root.enabled;

        clicked => {
            root.playback-toggle-requested();
        }
    }

    Text {
        width: 48px;
        height: 32px;
        text: "Volume";
        color: #E3E6ED;
        font-size: 13px;
        vertical-alignment: center;
    }

    Slider {
        width: 180px;
        height: 32px;

        enabled: root.enabled;
        minimum: 0;
        maximum: 1;
        value: min(1, max(0, root.volume));

        changed value => {
            root.volume-requested(self.value);
        }
    }

    // Keeps the controls grouped on the left.
    Rectangle {
        horizontal-stretch: 1;
        background: transparent;
    }
}
    }

    function format-time(seconds: float) -> string {
        let total = max(0, round(seconds));
        let minutes = floor(total / 60);
        let remaining = total - minutes * 60;

        return (minutes < 10 ? "0" : "") + minutes
            + ":"
            + (remaining < 10 ? "0" : "")
            + remaining;
    }
}