
import { ScrollView } from "std-widgets.slint";
import { TitleBar } from "components/title-bar.slint";
import { NowPlaying } from "components/now-playing.slint";
import { Playlist } from "components/playlist.slint";
import { OverlaySection } from "components/overlay-section.slint";
import { Footer } from "components/footer.slint";

export component MainWindow inherits Window {
    title: "Cypher's Song Request";
    no-frame: true;
    resize-border-width: 6px;

    preferred-width: 820px;
    preferred-height: 560px;
    min-width: 640px;
    min-height: 420px;
    background: #101114;

    in-out property <string> username: "Username";
    in-out property <bool> connected: false;
    in-out property <string> current-track: "Nothing playing";
    in-out property <string> current-artist: "Request a song to start playback";
    in-out property <[string]> queue-items: [];
    in-out property <int> selected-queue-index: -1;
    in-out property <bool> overlays-expanded: false;
    in-out property <bool> video-visible: false;
    in-out property <string> copy-status: "";

    callback connection-toggle-requested();
    callback skip-requested();
    callback video-visibility-changed(bool);
    callback minimize-requested();
    callback close-window-requested();
    callback open-creator-link();
    callback copy-overlay-url(string) -> bool;
    callback queue-item-selected(int);

    VerticalLayout {
        padding: 9px;
        spacing: 8px;

        // Keep the title bar fixed while the content scrolls.
        TitleBar {
            username: root.username;
            connected: root.connected;

            connection-toggle-requested => {
                root.connection-toggle-requested();
            }
            minimize-requested => {
                root.minimize-requested();
            }
            close-window-requested => {
                root.close-window-requested();
            }
        }

        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: as-needed;

            VerticalLayout {
                width: 100%;
                spacing: 8px;

                NowPlaying {
                    height: 124px;
                    vertical-stretch: 0;

                    current-track: root.current-track;
                    current-artist: root.current-artist;
                    video-visible: root.video-visible;

                    skip-requested => {
                        root.skip-requested();
                    }

                    video-toggle-requested => {
                        root.video-visible = !root.video-visible;
                        root.video-visibility-changed(root.video-visible);
                    }
                }

                // Preserve the existing preview animation.
                Rectangle {
                    width: 100%;
                    height: root.video-visible ? parent.width * 9 / 16 : 0px;
                    clip: true;
                    background: #08090B;
                    border-width: 1px;
                    border-color: root.video-visible ? #303238 : transparent;
                    border-radius: 4px;

                    animate height {
                        duration: 180ms;
                        easing: linear;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "VIDEO PREVIEW";
                            color: #0077C2;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Video playback will appear here";
                            color: #777A83;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    height: 18px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "PLAYLIST";
                        color: #E3E4E7;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    Rectangle {
                        background: #303238;
                        height: 1px;
                        horizontal-stretch: 1;
                    }
                }

                // Keep a useful playlist viewport while allowing
                // the overall content to scroll.
                Playlist {
                    height: 180px;
                    queue-items: root.queue-items;
                    selected-queue-index <=> root.selected-queue-index;

                    queue-item-selected(index) => {
                        root.queue-item-selected(index);
                    }
                }

                OverlaySection {
                    expanded <=> root.overlays-expanded;
                    copy-status <=> root.copy-status;

                    copy-overlay-url(url) => {
                        root.copy-overlay-url(url);
                    }
                }

                Footer {
                    open-creator-link => {
                        root.open-creator-link();
                    }
                }
            }
        }
    }
}
